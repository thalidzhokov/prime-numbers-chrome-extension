{
  "manifest_version": 3,
  "name": "Prime Numbers",
  "version": "1.0.0",
  "description": "Shows prime numbers from 1 to 1000 in a popup.",
  "icons": {
    "16": "icons/primes-ext-logo-16.png",
    "32": "icons/primes-ext-logo-32.png",
    "48": "icons/primes-ext-logo-48.png",
    "128": "icons/primes-ext-logo-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prime numbers",
    "default_icon": {
      "16": "icons/primes-ext-logo-16.png",
      "32": "icons/primes-ext-logo-32.png",
      "48": "icons/primes-ext-logo-48.png",
      "128": "icons/primes-ext-logo-128.png"
    }
  }
}
